@inject NavigationManager Nav
@inject IJSRuntime JS

<nav class="showmax-nav">
    <a href="/" class="logo">SHOWMAX</a>
    <div class="nav-links">
        <a href="/">Home</a>
        <a href="/movies">Movies</a>
        <a href="/series">Series</a>
        <a href="/search">Search</a>
        <a href="/plans">Plans</a>
        @if (isLoggedIn)
        {
            <a href="/watchlist" style="text-decoration:none; color:#ccc;">My List</a>
        }
    </div>
    <div class="nav-links">
        @if (isLoggedIn)
        {
            @if (isAdmin)
            {
                <a href="/admin" style="color:#e50914; font-size:14px; text-decoration:none;">
                    <i class="fas fa-cog"></i> Admin
                </a>
            }
            <a href="/profile" style="color:#aaa; font-size:14px; text-decoration:none;">
                <i class="fas fa-user-circle"></i> @userName
            </a>
            <button class="btn-showmax" style="padding:8px 20px; font-size:13px; margin-left:12px;"
                    @onclick="Logout">
                Logout
            </button>
        }
        else
        {
            <a href="/login" class="btn-outline" style="padding:8px 20px; font-size:13px;">Login</a>
            <a href="/register" class="btn-showmax" style="padding:8px 20px; font-size:13px;">Sign Up</a>
        }
    </div>
</nav>

@code {
    private bool isLoggedIn = false;
    private bool isAdmin = false;
    private string userName = "";
    private bool hasLoaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !hasLoaded)
        {
            hasLoaded = true;
            await CheckAuth();
        }
    }

    private async Task CheckAuth()
    {
        try
        {
            var token = await JS.InvokeAsync<string?>("localStorage.getItem", "token");
            var name = await JS.InvokeAsync<string?>("localStorage.getItem", "fullName");
            var role = await JS.InvokeAsync<string?>("localStorage.getItem", "role");

            isLoggedIn = !string.IsNullOrEmpty(token);
            userName = name ?? "";
            isAdmin = role == "Admin";

            StateHasChanged();
        }
        catch (Exception) { }
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "token");
        await JS.InvokeVoidAsync("localStorage.removeItem", "fullName");
        await JS.InvokeVoidAsync("localStorage.removeItem", "role");
        isLoggedIn = false;
        isAdmin = false;
        userName = "";
        Nav.NavigateTo("/", forceLoad: true);
    }
}