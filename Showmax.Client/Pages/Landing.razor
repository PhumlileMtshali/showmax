@page "/landing"
@inject NavigationManager Nav
@inject IJSRuntime JS

<!-- Navbar -->
<nav style="position:fixed; top:0; left:0; right:0; z-index:1000;
            padding:20px 60px; display:flex; align-items:center;
            justify-content:space-between;
            background:linear-gradient(to bottom, rgba(0,0,0,0.9), transparent);">
    <div style="font-size:2rem; font-weight:900; color:#e50914;
                letter-spacing:4px; font-family:'Arial Black', sans-serif;">
        SHOWMAX
    </div>
    <div style="display:flex; gap:12px;">
        <a href="/login" style="background:transparent; color:white; border:2px solid white;
                                padding:10px 24px; border-radius:4px; text-decoration:none;
                                font-weight:600; font-size:14px; transition:all 0.2s;">
            Sign In
        </a>
        <a href="/register" style="background:#e50914; color:white; border:2px solid #e50914;
                                   padding:10px 24px; border-radius:4px; text-decoration:none;
                                   font-weight:600; font-size:14px;">
            Get Started
        </a>
    </div>
</nav>

<!-- Hero Section -->
<div style="position:relative; height:100vh; overflow:hidden;
            background:linear-gradient(135deg, #0a0a0a 0%, #1a0000 50%, #0a0a0a 100%);">

    <!-- Background pattern -->
    <div style="position:absolute; inset:0; opacity:0.1;
                background-image: repeating-linear-gradient(
                    45deg, #e50914 0px, #e50914 1px,
                    transparent 0px, transparent 50%);
                background-size: 30px 30px;">
    </div>

    <!-- Content -->
    <div style="position:relative; z-index:1; display:flex; flex-direction:column;
                align-items:center; justify-content:center; height:100%;
                text-align:center; padding:0 20px;">

        <div style="display:inline-block; background:rgba(229,9,20,0.2);
                    border:1px solid #e50914; border-radius:20px;
                    padding:6px 20px; font-size:13px; color:#e50914;
                    font-weight:700; letter-spacing:2px; margin-bottom:24px;">
            STREAM UNLIMITED
        </div>

        <h1 style="font-size:clamp(2.5rem, 6vw, 5rem); font-weight:900;
                   line-height:1.1; margin-bottom:24px; max-width:800px;
                   font-family:'Arial Black', sans-serif;">
            Movies, Series &
            <span style="color:#e50914;">More.</span>
            <br />Watch Anywhere.
        </h1>

        <p style="font-size:1.2rem; color:#aaa; max-width:550px;
                  line-height:1.7; margin-bottom:40px;">
            Stream the latest movies and series on any device.
            Cancel anytime. Start watching today.
        </p>

        <div style="display:flex; gap:16px; flex-wrap:wrap; justify-content:center;">
            <a href="/register"
               style="background:#e50914; color:white; padding:16px 40px;
                      border-radius:4px; text-decoration:none; font-size:18px;
                      font-weight:700; transition:background 0.2s;">
                Start Watching — It's Free
            </a>
            <a href="/login"
               style="background:rgba(255,255,255,0.1); color:white; padding:16px 40px;
                      border-radius:4px; text-decoration:none; font-size:18px;
                      font-weight:700; border:2px solid rgba(255,255,255,0.3);">
                Sign In
            </a>
        </div>

        <p style="color:#555; font-size:13px; margin-top:20px;">
            No credit card required to get started
        </p>
    </div>

    <!-- Scroll indicator -->
    <div style="position:absolute; bottom:32px; left:50%; transform:translateX(-50%);
                display:flex; flex-direction:column; align-items:center; gap:8px;
                color:#555; font-size:12px; animation: bounce 2s infinite;">
        <span>Scroll to explore</span>
        <i class="fas fa-chevron-down"></i>
    </div>
</div>

<!-- Features Section -->
<div style="background:#0a0a0a; padding:100px 60px;">
    <div style="text-align:center; margin-bottom:60px;">
        <h2 style="font-size:2.5rem; font-weight:900; margin-bottom:16px;">
            Why Choose Showmax?
        </h2>
        <p style="color:#aaa; font-size:16px; max-width:500px; margin:0 auto;">
            Everything you need for the ultimate streaming experience
        </p>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(250px, 1fr));
                gap:32px; max-width:1100px; margin:0 auto;">

        @foreach (var feature in features)
        {
            <div style="background:#111; border-radius:12px; padding:32px;
                            border:1px solid #1a1a1a; text-align:center;
                            transition:transform 0.3s, border-color 0.3s;">
                <div style="width:64px; height:64px; background:rgba(229,9,20,0.15);
                                border:2px solid #e50914; border-radius:50%;
                                display:flex; align-items:center; justify-content:center;
                                margin:0 auto 20px;">
                    <i class="@feature.Icon" style="font-size:1.5rem; color:#e50914;"></i>
                </div>
                <h3 style="font-size:1.1rem; font-weight:700; margin-bottom:12px;">
                    @feature.Title
                </h3>
                <p style="color:#aaa; font-size:14px; line-height:1.7;">
                    @feature.Description
                </p>
            </div>
        }
    </div>
</div>

<!-- Plans Section -->
<div style="background:#060606; padding:100px 60px;">
    <div style="text-align:center; margin-bottom:60px;">
        <h2 style="font-size:2.5rem; font-weight:900; margin-bottom:16px;">
            Simple, Transparent Pricing
        </h2>
        <p style="color:#aaa; font-size:16px;">Cancel anytime. No hidden fees.</p>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));
                gap:24px; max-width:900px; margin:0 auto;">
        @foreach (var plan in plans)
        {
            <div style="background:@(plan.IsPopular ? "#1a0000" : "#111");
                            border:2px solid @(plan.IsPopular ? "#e50914" : "#222");
                            border-radius:12px; padding:32px; text-align:center;
                            position:relative;">
                @if (plan.IsPopular)
                {
                    <div style="position:absolute; top:-14px; left:50%; transform:translateX(-50%);
                                        background:#e50914; color:white; padding:4px 20px;
                                        border-radius:20px; font-size:11px; font-weight:700;
                                        white-space:nowrap; letter-spacing:1px;">
                        MOST POPULAR
                    </div>
                }
                <h3 style="font-size:1.3rem; font-weight:900; margin-bottom:8px;">
                    @plan.Name
                </h3>
                <p style="color:#aaa; font-size:13px; margin-bottom:20px;">@plan.Description</p>
                <div style="font-size:2.5rem; font-weight:900; color:@(plan.IsPopular ? "#e50914" : "white");
                                margin-bottom:4px;">
                    R@(plan.Price)
                </div>
                <div style="color:#666; font-size:13px; margin-bottom:24px;">/month</div>
                <a href="/register"
                   style="display:block; background:@(plan.IsPopular ? "#e50914" : "transparent");
                              color:white; padding:12px; border-radius:4px; text-decoration:none;
                              font-weight:700; border:2px solid @(plan.IsPopular ? "#e50914" : "white");">
                    Get Started
                </a>
            </div>
        }
    </div>
</div>

<!-- Content Preview Section -->
<div style="background:#0a0a0a; padding:100px 60px;">
    <div style="text-align:center; margin-bottom:60px;">
        <h2 style="font-size:2.5rem; font-weight:900; margin-bottom:16px;">
            What's on Showmax?
        </h2>
        <p style="color:#aaa; font-size:16px;">
            Thousands of titles across every genre
        </p>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(140px, 1fr));
                gap:12px; max-width:1100px; margin:0 auto 48px;">
        @foreach (var genre in genres)
        {
            <div style="background:linear-gradient(135deg, #1a1a1a, #111);
                            border:1px solid #222; border-radius:8px; padding:20px;
                            text-align:center; cursor:pointer;">
                <i class="@genre.Icon" style="font-size:1.5rem; color:#e50914; margin-bottom:8px; display:block;"></i>
                <div style="font-size:13px; font-weight:600;">@genre.Name</div>
            </div>
        }
    </div>

    <div style="text-align:center;">
        <a href="/register" class="btn-showmax" style="font-size:16px; padding:14px 40px;">
            Browse All Content
        </a>
    </div>
</div>

<!-- FAQ Section -->
<div style="background:#060606; padding:100px 60px;">
    <div style="text-align:center; margin-bottom:60px;">
        <h2 style="font-size:2.5rem; font-weight:900; margin-bottom:16px;">
            Frequently Asked Questions
        </h2>
    </div>

    <div style="max-width:700px; margin:0 auto;">
        @foreach (var faq in faqs)
        {
            <div style="border-bottom:1px solid #1a1a1a; padding:24px 0;">
                <div style="display:flex; justify-content:space-between; align-items:center;
                                cursor:pointer; font-size:16px; font-weight:600;"
                     @onclick="() => ToggleFaq(faq)">
                    <span>@faq.Question</span>
                    <i class="fas @(faq.IsOpen ? "fa-minus" : "fa-plus")"
                       style="color:#e50914; font-size:14px;"></i>
                </div>
                @if (faq.IsOpen)
                {
                    <p style="color:#aaa; font-size:14px; line-height:1.7;
                                      margin-top:16px; margin-bottom:0;">
                        @faq.Answer
                    </p>
                }
            </div>
        }
    </div>
</div>

<!-- CTA Section -->
<div style="background:linear-gradient(135deg, #1a0000, #0a0a0a);
            padding:100px 60px; text-align:center;
            border-top:1px solid #1a1a1a;">
    <h2 style="font-size:3rem; font-weight:900; margin-bottom:16px;">
        Ready to Watch?
    </h2>
    <p style="color:#aaa; font-size:16px; margin-bottom:40px; max-width:400px; margin-left:auto; margin-right:auto;">
        Join thousands of viewers already enjoying Showmax
    </p>
    <a href="/register"
       style="background:#e50914; color:white; padding:18px 48px; border-radius:4px;
              text-decoration:none; font-size:18px; font-weight:700; display:inline-block;">
        Start Watching Today
    </a>
</div>

<!-- Footer -->
<div style="background:#000; padding:40px 60px; border-top:1px solid #1a1a1a;">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
        <div style="font-size:1.5rem; font-weight:900; color:#e50914; letter-spacing:3px;">
            SHOWMAX
        </div>
        <div style="display:flex; gap:24px; flex-wrap:wrap;">
            <a href="/login" style="color:#666; text-decoration:none; font-size:13px;">Sign In</a>
            <a href="/register" style="color:#666; text-decoration:none; font-size:13px;">Register</a>
            <a href="/plans" style="color:#666; text-decoration:none; font-size:13px;">Plans</a>
        </div>
        <div style="color:#444; font-size:12px;">
            © 2026 Showmax Clone. Built with C# & Blazor.
        </div>
    </div>
</div>

<style>
    @@keyframes bounce {
        0%, 100% {
            transform: translateX(-50%) translateY(0);
        }

        50% {
            transform: translateX(-50%) translateY(-10px);
        }
    }
</style>

@code {
    protected override async Task OnInitializedAsync()
    {
        // If already logged in redirect to home
        var token = await JS.InvokeAsync<string?>("localStorage.getItem", "token");
        if (!string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("/");
        }
    }

    private List<FeatureItem> features = new()
    {
        new FeatureItem { Icon = "fas fa-film", Title = "Thousands of Titles", Description = "Access a massive library of movies and series across every genre imaginable." },
        new FeatureItem { Icon = "fas fa-mobile-alt", Title = "Watch Anywhere", Description = "Stream on your phone, tablet, laptop or TV. Your content follows you everywhere." },
        new FeatureItem { Icon = "fas fa-download", Title = "Download & Watch", Description = "Download your favourite content and watch offline whenever you want." },
        new FeatureItem { Icon = "fas fa-users", Title = "Multiple Profiles", Description = "Create profiles for everyone in the family including a dedicated Kids profile." },
        new FeatureItem { Icon = "fas fa-ban", Title = "No Ads", Description = "Enjoy uninterrupted streaming with zero advertisements on all plans." },
        new FeatureItem { Icon = "fas fa-times-circle", Title = "Cancel Anytime", Description = "No long-term contracts. Cancel your subscription at any time with no penalties." },
    };

    private List<PlanItem> plans = new()
    {
        new PlanItem { Name = "Basic", Price = 99, Description = "For one device", IsPopular = false },
        new PlanItem { Name = "Standard", Price = 149, Description = "For the family", IsPopular = true },
        new PlanItem { Name = "Premium", Price = 199, Description = "Ultimate experience", IsPopular = false },
    };

    private List<GenreItem> genres = new()
    {
        new GenreItem { Name = "Action", Icon = "fas fa-fist-raised" },
        new GenreItem { Name = "Drama", Icon = "fas fa-theater-masks" },
        new GenreItem { Name = "Comedy", Icon = "fas fa-laugh" },
        new GenreItem { Name = "Thriller", Icon = "fas fa-skull" },
        new GenreItem { Name = "Horror", Icon = "fas fa-ghost" },
        new GenreItem { Name = "Romance", Icon = "fas fa-heart" },
        new GenreItem { Name = "Documentary", Icon = "fas fa-camera" },
        new GenreItem { Name = "Animation", Icon = "fas fa-paint-brush" },
    };

    private List<FaqItem> faqs = new()
    {
        new FaqItem { Question = "What is Showmax?", Answer = "Showmax is a video-on-demand streaming service that gives you access to thousands of movies and series. Watch on any device, anytime." },
        new FaqItem { Question = "How much does Showmax cost?", Answer = "Showmax offers three plans: Basic at R99/month, Standard at R149/month, and Premium at R199/month. All plans include access to the full content library." },
        new FaqItem { Question = "Can I cancel anytime?", Answer = "Yes! There are no long-term contracts. You can cancel your subscription at any time and you will not be charged again." },
        new FaqItem { Question = "How many devices can I watch on?", Answer = "It depends on your plan. Basic allows 1 device, Standard allows 2 devices, and Premium allows up to 4 devices simultaneously." },
        new FaqItem { Question = "Is there a free trial?", Answer = "Yes! You can create a free account and browse all content. Subscribe to any plan to start watching." },
    };

    private void ToggleFaq(FaqItem faq)
    {
        faq.IsOpen = !faq.IsOpen;
    }

    private class FeatureItem
    {
        public string Icon { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
    }

    private class PlanItem
    {
        public string Name { get; set; } = "";
        public int Price { get; set; }
        public string Description { get; set; } = "";
        public bool IsPopular { get; set; }
    }

    private class GenreItem
    {
        public string Name { get; set; } = "";
        public string Icon { get; set; } = "";
    }

    private class FaqItem
    {
        public string Question { get; set; } = "";
        public string Answer { get; set; } = "";
        public bool IsOpen { get; set; } = false;
    }
}